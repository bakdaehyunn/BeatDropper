{
  "name": "dropper-ai",
  "productName": "BeatDropper",
  "version": "0.1.0",
  "private": true,
  "description": "Native macOS DJ library and AI-assisted mix planner",
  "scripts": {
    "security:scan": "node scripts/security-scan.cjs",
    "security:check": "npm run security:scan && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:build": "swift build --package-path native",
    "native:benchmark:analysis": "node scripts/evaluate-native-analysis-benchmarks.cjs",
    "native:benchmark:analysis:create": "node scripts/create-analysis-benchmark-fixture.cjs",
    "native:benchmark:analysis:extract": "swift run --package-path native BeatDropperNativeAnalysisExtract",
    "native:benchmark:analysis:inventory": "node scripts/inventory-dsp-calibration-audio.cjs",
    "native:benchmark:analysis:review": "node scripts/review-dsp-calibration-batch.cjs",
    "native:benchmark:analysis:gate": "node scripts/evaluate-native-analysis-benchmarks.cjs --allow-expected-grades --write-json native/dist/analysis-benchmark-report.json",
    "native:benchmark:analysis:corpus-gate": "node scripts/evaluate-native-analysis-benchmarks.cjs --allow-expected-grades --corpus-gate docs/dsp-benchmark-corpus-gate-v1.json --write-json native/dist/analysis-benchmark-corpus-report.json",
    "native:benchmark:planner": "node scripts/evaluate-native-planner-benchmarks.cjs",
    "native:accessibility:check": "node scripts/check-native-accessibility.cjs",
    "native:macos-shell:check": "node scripts/check-native-macos-shell.cjs",
    "native:test": "swift test --package-path native",
    "native:package": "scripts/package-native-app.sh",
    "native:parity": "node scripts/evaluate-native-parity.cjs",
    "native:parity:report": "node scripts/evaluate-native-parity.cjs --report-only",
    "native:preflight:local": "node scripts/run-native-local-preflight.cjs",
    "native:preflight:release": "node scripts/run-native-local-preflight.cjs --strict-release",
    "native:release": "npm run native:preflight:release && NOTARIZE=1 scripts/package-native-app.sh && node scripts/verify-native-release.cjs && npm run native:release:smoke",
    "native:release:check": "node scripts/check-native-release-readiness.cjs",
    "native:release:manifest": "node scripts/write-native-release-manifest.cjs",
    "native:release:setup": "node scripts/setup-native-release-profile.cjs --store-profile",
    "native:release:setup:check": "node scripts/setup-native-release-profile.cjs --check",
    "native:release:smoke": "node scripts/smoke-native-release.cjs",
    "native:release:verify": "node scripts/verify-native-release.cjs",
    "native:release:verify:local": "node scripts/verify-native-release.cjs --allow-ad-hoc",
    "native:run": "swift run --package-path native BeatDropperNative",
    "native:smoke": "node scripts/smoke-native-app.cjs",
    "native:smoke:dmg": "node scripts/smoke-native-dmg.cjs",
    "native:stress:library": "node scripts/stress-native-library.cjs",
    "native:stress:open-import": "node scripts/stress-native-open-import.cjs",
    "native:stress:playback": "node scripts/stress-native-playback.cjs",
    "native:stress:session": "node scripts/stress-native-session.cjs",
    "native:stress:session:extended": "node scripts/stress-native-session.cjs --extended",
    "native:validate:loudness-reference": "node scripts/validate-loudness-reference.cjs",
    "native:validate:real-folder": "node scripts/validate-native-real-folder.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
